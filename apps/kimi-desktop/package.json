{
  "name": "@moonshot-ai/kimi-desktop",
  "version": "2.1.0",
  "private": true,
  "license": "MIT",
  "description": "Kimi Code desktop client — an Electron shell around the Kimi web UI.",
  "author": "Moonshot AI",
  "homepage": "https://github.com/MoonshotAI/kimi-code",
  "type": "module",
  "main": "out/main.cjs",
  "scripts": {
    "build": "tsdown",
    "start": "electron .",
    "dev": "tsdown && electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dist": "tsdown && electron-builder --config electron-builder.config.cjs",
    "dist:dir": "tsdown && electron-builder --config electron-builder.config.cjs --dir"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "tsdown": "0.23.0",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  }
}
